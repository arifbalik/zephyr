config INPUT_STM32_TSC_KEYS
	bool "STM32 touch keys (TSC)"
	default y
	depends on DT_HAS_ST_STM32_TSC_ENABLED
	help
	  Touch keys on the STM32 Touch Sensing Controller (TSC).

config INPUT_STM32_TSC_KEYS_BUFFER_WORD_SIZE
	int "Samples kept per touch key"
	default 10
	range 1 256
	depends on INPUT_STM32_TSC_KEYS
	help
	  Number of samples the driver keeps for each key. A key is pressed
	  when the newest sample is lower than the oldest one by more than
	  the noise-threshold of the key.

	  The samples span this value times sampling-interval-ms, 100 ms
	  with the defaults. A touch has to arrive within that time.
